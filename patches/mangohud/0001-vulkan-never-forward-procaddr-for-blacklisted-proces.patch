diff --git a/src/blacklist.cpp b/src/blacklist.cpp
index d137cf1..ecd4c30 100644
--- a/src/blacklist.cpp
+++ b/src/blacklist.cpp
@@ -106,4 +106,29 @@ void add_blacklist(const std::string& new_item) {
     is_blacklisted(true);
 }
 
+/* ProtoGoblin: check the MANGOHUD_CONFIG blacklist entries against the current
+ * process name without a full overlay_params parse.  Needed because the config
+ * is normally parsed inside CreateInstance, far too late for helper processes
+ * (e.g. Proton's steam.exe shim) that must never instantiate the layer. */
+bool is_config_blacklisted() {
+    const char *conf = getenv("MANGOHUD_CONFIG");
+    if (!conf || !*conf)
+        return false;
+
+    const std::string proc_name = get_proc_name();
+    const std::string key = "blacklist=";
+    std::string s(conf);
+    size_t pos = 0;
+    while (true) {
+        size_t comma = s.find(',', pos);
+        std::string token = s.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+        if (token.rfind(key, 0) == 0 && token.substr(key.size()) == proc_name)
+            return true;
+        if (comma == std::string::npos)
+            break;
+        pos = comma + 1;
+    }
+    return false;
+}
+
 
